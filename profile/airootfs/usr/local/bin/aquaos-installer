#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

if ! command -v archinstall >/dev/null 2>&1; then
  printf '\n\033[1;31m El instalador de AquaOS no está disponible\033[0m\n'
  printf 'No se encontró el paquete archinstall de Arch Linux.\n\n'
  read -r -p 'Pulsa Intro para cerrar...'
  exit 1
fi

if ! command -v dialog >/dev/null 2>&1; then
  exec archinstall "$@"
fi

while true; do
  choice=$(dialog --clear --backtitle 'AquaOS 26 H2 · Arch Linux' \
    --title ' AQUAOS 26 H2 ' \
    --menu $'\nTe damos la bienvenida al instalador experimental de AquaOS.\n\nSe abrirá la utilidad estándar archinstall de Arch Linux. Revisa cuidadosamente el disco y las particiones antes de continuar.\n' 18 76 5 \
    instalar 'Continuar con archinstall' \
    notas 'Leer las notas de instalación' \
    salir 'Volver al escritorio' \
    3>&1 1>&2 2>&3) || exit 0

  case "$choice" in
    instalar)
      clear
      printf '\033[1;36m\n  AquaOS 26 H2  /  ARCHINSTALL\033[0m\n'
      printf '  Perfil experimental · revisa el disco antes de escribir\n\n'
      exec archinstall "$@"
      ;;
    notas)
      dialog --backtitle 'AquaOS 26 H2 · Arch Linux' --title 'Antes de instalar' \
        --msgbox 'AquaOS es un perfil Archiso experimental. El instalador es archinstall de Arch Linux; todavía no existe un instalador gráfico propio de AquaOS. Haz una copia de seguridad y prueba primero en una máquina virtual.' 12 76
      ;;
    salir) exit 0 ;;
  esac
done
