#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "Ejecuta este script con sudo."
  exit 1
fi

echo "Configuración inicial de AquaOS 26 H2"
echo "Ollama está instalado; no se descargará ningún modelo ni agente de IA."
systemctl enable ollama.service

if ! command -v yay >/dev/null 2>&1; then
  echo
  echo "Google Chrome no está incluido en esta versión experimental."
  echo "La información de AquaOS está en la página del proyecto."
  echo
fi

echo "AquaOS: configuración básica completada."
